/**
 * ============================================================
 * SecureLock - Secrets Configuration Template
 * ============================================================
 * 
 * SETUP INSTRUCTIONS:
 *   1. Copy this file to secrets.h in the same directory
 *   2. Fill in your WiFi and Telegram credentials
 *   3. secrets.h is gitignored — never commit real credentials
 * 
 * ============================================================
 */

#ifndef SECRETS_H
#define SECRETS_H

#include <Arduino.h>

// ============================================================
// 📶 WiFi Configuration
// ============================================================
#define WIFI_SSID           "YOUR_WIFI_SSID"
#define WIFI_PASSWORD       "YOUR_WIFI_PASSWORD"

// Optional roaming AP credentials for WiFiMulti (leave empty if unused)
#define WIFI_EXTRA_1_SSID      ""
#define WIFI_EXTRA_1_PASSWORD  ""
#define WIFI_EXTRA_2_SSID      ""
#define WIFI_EXTRA_2_PASSWORD  ""
#define WIFI_EXTRA_3_SSID      ""
#define WIFI_EXTRA_3_PASSWORD  ""
#define WIFI_EXTRA_4_SSID      ""
#define WIFI_EXTRA_4_PASSWORD  ""

// ============================================================
// 🤖 Telegram Bot Configuration
// ============================================================
// Step 1: Message @BotFather on Telegram, send /newbot
// Step 2: Copy the token provided
#define BOT_TOKEN           "1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"

// Step 3: Message @userinfobot to get admin Chat IDs
// Multiplayer mode: every Chat ID listed here is treated as admin.
const String ADMIN_CHAT_IDS[] = {
	"123456789"
};
const int NUM_ADMINS = sizeof(ADMIN_CHAT_IDS) / sizeof(ADMIN_CHAT_IDS[0]);

// Optional: Telegram polling slot depth used by firmware.
// Increase with caution to avoid loop starvation on weak networks.
#ifndef HANDLE_MESSAGES
#define HANDLE_MESSAGES 3
#endif

// ============================================================
// 🔐 Dashboard Admin API Credentials (Server-Side)
// ============================================================
#define DASHBOARD_ADMIN_1_USERNAME  "admin1"
#define DASHBOARD_ADMIN_1_PASSWORD  "CHANGE_ME_NOW"
#define DASHBOARD_ADMIN_2_USERNAME  "admin2"
#define DASHBOARD_ADMIN_2_PASSWORD  "CHANGE_ME_NOW"

// Backward-compatible aliases (used by legacy code paths).
#define DASHBOARD_ADMIN_USERNAME  DASHBOARD_ADMIN_1_USERNAME
#define DASHBOARD_ADMIN_PASSWORD  DASHBOARD_ADMIN_1_PASSWORD

// ============================================================
// 🔧 Optional Hardware Overrides (Advanced)
// ============================================================
// IMPORTANT: Use GPIO pin labels (e.g., 14), NOT breadboard row numbers.
// Example: if buzzer+ is wired to GPIO14 and buzzer- to GND:
//   SECURELOCK_PIN_BUZZER = 14, SECURELOCK_BUZZER_ACTIVE_HIGH = 1
// Example: if buzzer+ is wired to 3V3 and buzzer- to GPIO14:
//   SECURELOCK_PIN_BUZZER = 14, SECURELOCK_BUZZER_ACTIVE_HIGH = 0

#define SECURELOCK_PIN_BUZZER          14
#define SECURELOCK_BUZZER_ACTIVE_HIGH  1

#endif // SECRETS_H
