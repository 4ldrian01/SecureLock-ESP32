{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "platformio run",
      "type": "shell",
      "command": "${env:HOME}/.platformio/penv/bin/pio",
      "windows": {
        "command": "C:\\pio_core\\penv\\Scripts\\platformio.exe"
      },
      "args": [
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "platformio run --target upload",
      "type": "shell",
      "command": "${env:HOME}/.platformio/penv/bin/pio",
      "windows": {
        "command": "C:\\pio_core\\penv\\Scripts\\platformio.exe"
      },
      "args": [
        "run",
        "--target",
        "upload"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "platformio device monitor",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "timeout 20 ${env:HOME}/.platformio/penv/bin/pio device monitor -b 115200 -f direct || true"
      ],
      "windows": {
        "command": "C:\\pio_core\\penv\\Scripts\\platformio.exe",
        "args": [
          "device",
          "monitor",
          "-b",
          "115200",
          "-f",
          "direct"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "PlatformIO: Monitor (Live)",
      "type": "shell",
      "command": "${env:HOME}/.platformio/penv/bin/pio",
      "windows": {
        "command": "C:\\pio_core\\penv\\Scripts\\platformio.exe"
      },
      "args": [
        "device",
        "monitor",
        "-b",
        "115200",
        "-f",
        "direct"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "platformio run --target uploadfs",
      "type": "shell",
      "command": "${env:HOME}/.platformio/penv/bin/pio",
      "windows": {
        "command": "C:\\pio_core\\penv\\Scripts\\platformio.exe"
      },
      "args": [
        "run",
        "--target",
        "uploadfs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "PlatformIO: Deploy All (Safe)",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/deploy_safe.sh"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/deploy_all.ps1"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
